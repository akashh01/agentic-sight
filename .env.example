# Logging (DEBUG shows full prompts and raw model responses)
LOG_LEVEL=INFO

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
AGENT_MODEL=llama3.1:8b
CHEAP_MODEL=moondream
EXPENSIVE_MODEL=llava:13b

# Sampling / detection tuning
SAMPLE_RATE_FPS=0.5
ESCALATION_MARGIN=0.15
CONFIDENCE_THRESHOLD=0.6
# seconds before/after a candidate hit to check before trusting it; 0 disables
CONFIRMATION_OFFSET_SEC=1.0
# false = never escalate to the expensive model, stay on the cheap tier always
ESCALATION_ENABLED=true

# SMTP (Gmail app password works for testing)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
RECIPIENT_EMAIL=
DRY_RUN_EMAIL=true

# Storage
DB_PATH=events.db

# Observability — local self-hosted Phoenix, no Docker needed:
#   pip install arize-phoenix   (already in this project's deps)
#   phoenix serve               (leave running in its own terminal, UI at localhost:6006)
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=helmet-agent
